<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:pe="using:Octopus.App.Settings.PromptEnhancement"
             x:Class="Octopus.App.Settings.PromptEnhancement.PromptEnhancementPageView"
             x:DataType="pe:PromptEnhancementSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.endpointCard">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Grid.fieldRow">
            <Setter Property="ColumnSpacing" Value="10" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.testOk">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="TextBlock.testFailed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="{l:AppLangResource SettingsPromptEnhancementTitle}" />
            <TextBlock Classes="subtitle" Text="{l:AppLangResource SettingsPromptEnhancementSubtitle}" />
        </StackPanel>

        <arc:SettingsGroup Appearance="Plain" LabelWidth="260" ContentAlignment="Stretch">
            <arc:SettingsRow Header="{l:AppLangResource SettingsPromptEnhancementDefault}"
                             Description="{l:AppLangResource SettingsPromptEnhancementDefaultHint}">
                <arc:Select x:Name="DefaultEndpointSelect" AutoScrollToSelectedItem="False" Size="Small"
                            HorizontalAlignment="Left" Width="320"
                            AutomationProperties.Name="{l:AppLangResource SettingsPromptEnhancementDefault}"
                            ItemsSource="{Binding DefaultChoices}"
                            SelectedValue="{Binding DefaultEndpointId, Mode=TwoWay}" />
            </arc:SettingsRow>
        </arc:SettingsGroup>

        <StackPanel Spacing="4">
            <TextBlock Classes="group" Text="{l:AppLangResource SettingsPromptEnhancementEndpoints}" Margin="2,0,0,0" />
            <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementEndpointsHint}"
                       TextWrapping="Wrap" Margin="2,0,0,0" />
        </StackPanel>

        <ItemsControl x:Name="EndpointList" ItemsSource="{Binding Endpoints}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pe:PromptEnhancementEndpointViewModel">
                    <Border Classes="endpointCard">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="name" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <Border Padding="6,1" CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                            IsVisible="{Binding IsDefault}" VerticalAlignment="Center">
                                        <TextBlock Text="{l:AppLangResource SettingsPromptEnhancementDefaultBadge}"
                                                   FontSize="10.5" FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <arc:Button Variant="Secondary" Size="Small"
                                                IsEnabled="{Binding !IsTesting}"
                                                Command="{Binding TestCommand}"
                                                AutomationProperties.Name="{l:AppLangResource SettingsPromptEnhancementTest}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsTesting}" VerticalAlignment="Center" />
                                            <lucide:LucideIcon Kind="FlaskConical" Size="11" IsVisible="{Binding !IsTesting}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{Binding TestButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </arc:Button>
                                    <arc:Button Classes="icon" Variant="Ghost"
                                                Command="{Binding DeleteCommand}"
                                                AutomationProperties.Name="{l:AppLangResource SettingsPromptEnhancementDelete}"
                                                arc:Tooltip.Tip="{l:AppLangResource SettingsPromptEnhancementDelete}">
                                        <lucide:LucideIcon Kind="Trash2" Size="13" />
                                    </arc:Button>
                                </StackPanel>
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementName}" />
                                <arc:Input Grid.Column="1" Size="Small"
                                           Label="{l:AppLangResource SettingsPromptEnhancementName}" IsLabelVisible="False"
                                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementProtocol}" />
                                <arc:Select Grid.Column="1" AutoScrollToSelectedItem="False" Size="Small"
                                            HorizontalAlignment="Left" Width="260"
                                            ItemsSource="{Binding ProtocolChoices}"
                                            SelectedValue="{Binding Protocol, Mode=TwoWay}" />
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementBaseUrl}" />
                                <arc:Input Grid.Column="1" Size="Small"
                                           Label="{l:AppLangResource SettingsPromptEnhancementBaseUrl}" IsLabelVisible="False"
                                           Placeholder="{l:AppLangResource SettingsPromptEnhancementBaseUrlPlaceholder}"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementModel}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <arc:Input Size="Small"
                                               Label="{l:AppLangResource SettingsPromptEnhancementModel}" IsLabelVisible="False"
                                               Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementModelHint}" />
                                </StackPanel>
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementApiKey}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <arc:Input Size="Small" Width="260" PasswordChar="•"
                                                   IsEnabled="{Binding IsKeystoreAvailable}"
                                                   Label="{l:AppLangResource SettingsPromptEnhancementApiKey}" IsLabelVisible="False"
                                                   Placeholder="{Binding KeyStateText}"
                                                   Text="{Binding KeyDraft, Mode=TwoWay}" />
                                        <arc:Button Variant="Secondary" Size="Small"
                                                    IsEnabled="{Binding IsKeystoreAvailable}"
                                                    Content="{l:AppLangResource SettingsPromptEnhancementKeySave}"
                                                    Command="{Binding SaveKeyCommand}" />
                                        <arc:Button Variant="Ghost" Size="Small"
                                                    IsVisible="{Binding HasSavedKey}"
                                                    Content="{l:AppLangResource SettingsPromptEnhancementKeyClear}"
                                                    Command="{Binding ClearKeyCommand}" />
                                    </StackPanel>
                                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementKeyKeystoreUnavailable}"
                                               IsVisible="{Binding !IsKeystoreAvailable}" />
                                </StackPanel>
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementTemperature}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <arc:NumberField Minimum="0" Maximum="2" Step="0.1" Size="Small"
                                                     HorizontalAlignment="Left" Width="140" UseGrouping="False"
                                                     Label="{l:AppLangResource SettingsPromptEnhancementTemperature}" IsLabelVisible="False"
                                                     Value="{Binding Temperature, Mode=TwoWay}" />
                                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementTemperatureHint}" />
                                </StackPanel>
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementMaxTokens}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <arc:NumberField Minimum="64" Maximum="8192" Step="64" Size="Small"
                                                     HorizontalAlignment="Left" Width="160" UseGrouping="False"
                                                     Label="{l:AppLangResource SettingsPromptEnhancementMaxTokens}" IsLabelVisible="False"
                                                     Value="{Binding MaxTokens, Mode=TwoWay}" />
                                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementMaxTokensHint}" />
                                </StackPanel>
                            </Grid>

                            <Grid Classes="fieldRow" ColumnDefinitions="132,*">
                                <TextBlock Classes="fieldLabel" Text="{l:AppLangResource SettingsPromptEnhancementSystemPrompt}"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <arc:Input Size="Small" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                               Label="{l:AppLangResource SettingsPromptEnhancementSystemPrompt}" IsLabelVisible="False"
                                               Text="{Binding SystemPrompt, Mode=TwoWay}" />
                                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsPromptEnhancementSystemPromptHint}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="hint" IsVisible="{Binding HasTestResult}" TextWrapping="Wrap"
                                       Text="{Binding TestResult}"
                                       Classes.testFailed="{Binding TestFailed}"
                                       Classes.testOk="{Binding !TestFailed}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <arc:Button x:Name="AddEndpointButton" Variant="Secondary" Size="Small"
                    HorizontalAlignment="Left"
                    Command="{Binding AddCommand}"
                    AutomationProperties.Name="{l:AppLangResource SettingsPromptEnhancementAdd}">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <lucide:LucideIcon Kind="Plus" Size="12" VerticalAlignment="Center" />
                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{l:AppLangResource SettingsPromptEnhancementAdd}" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </StackPanel>
</UserControl>
